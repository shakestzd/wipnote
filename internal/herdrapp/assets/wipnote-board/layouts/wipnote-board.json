{
  "id": "root", "type": "row", "divider": { "width": 1, "color": "border" },
  "children": [
    { "id": "board", "type": "block", "size": { "px": 320 }, "min": 200, "max": 560, "content": { "mod": "wipnote-board" } },
    { "id": "work", "type": "column", "children": [
      { "id": "tabs", "type": "block", "size": { "px": 30 }, "content": { "mod": "tabs" } },
      { "id": "main", "type": "block", "content": { "tab": "active", "pane": {
        "gap": 6, "radius": 6, "lone": true,
        "header": { "content": { "mod": "wipnote-pane-header" }, "height": 30, "position": "top", "reveal": "always" },
        "border": { "width": 1, "color": "border" }, "focus": { "width": 1, "color": "accent" }
      } } }
    ] }
  ]
}
