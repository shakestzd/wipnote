{
  "rules": [
    { "match": ["pane", "get", "w1:p9"], "replies": [ { "error": { "code": "pane_not_found", "message": "no pane w1:p9" } } ] },
    { "match": ["agent", "get", "w1:p2"], "replies": [ { "shape": { "as": "agent_info", "pane_id": "w1:p2", "status": "idle" } } ] },
    { "match": ["agent", "prompt", "w1:p2", "**"], "replies": [ { "error": { "code": "timeout", "message": "agent did not settle" } } ] },
    { "match": ["pane", "close", "w1:p2"], "replies": [ { "stderr": "error: unknown option: --timeout\n", "exit": 2 } ] }
  ]
}
