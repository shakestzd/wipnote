            "args": [
              "hook",
              "worktree-remove"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "wipnote",
            "args": [
              "hook",
              "post-compact"
            ],
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "matcher": "",
        "hooks": [
