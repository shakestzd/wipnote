      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "wipnote hook post-compact",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "wipnote hook task-created",
            "timeout": 15,
            "async": true
          }
        ]
      }
