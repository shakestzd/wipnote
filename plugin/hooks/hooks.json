{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "wipnote",
            "args": [
              "hook",
              "session-start"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "wipnote",
            "args": [
              "hook",
              "session-resume"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "wipnote",
            "args": [
              "hook",
              "session-end"
            ],
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "wipnote",
            "args": [
              "hook",
              "user-prompt"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "wipnote",
            "args": [
              "hook",
              "pretooluse"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "wipnote",
            "args": [
              "hook",
              "posttooluse"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "wipnote",
            "args": [
              "hook",
              "posttooluse-record"
            ],
            "timeout": 15,
            "async": true
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "wipnote",
            "args": [
              "hook",
              "exit-plan-mode"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "wipnote",
            "args": [
              "hook",
              "subagent-start"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "wipnote",
            "args": [
              "hook",
              "subagent-stop"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "wipnote",
            "args": [
              "hook",
              "stop"
            ],
            "timeout": 90
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "wipnote",
            "args": [
              "hook",
              "posttooluse-failure"
            ],
            "timeout": 15,
            "async": true
          }
        ]
