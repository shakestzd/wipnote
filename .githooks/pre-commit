#!/bin/sh
# Pre-commit hook: Go quality gates
#
# Install: wipnote install-hooks
#          (sets core.hooksPath = .githooks)

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
echo "Running pre-commit checks..."

# Go source is at the repo root (go.mod, cmd/, internal/)
if git diff --cached --name-only | grep -q '\.go$' || [ -f "$REPO_ROOT/go.mod" ]; then
    if [ ! -f "$REPO_ROOT/go.mod" ]; then
        echo "  Warning: no go.mod found at repo root, skipping Go checks."
    else
        echo "  -> go build..."
        if ! (cd "$REPO_ROOT" && go build ./...) ; then
            echo "FAIL: go build failed. Fix compilation errors before committing."
            exit 1
        fi

        echo "  -> go vet..."
        if ! (cd "$REPO_ROOT" && go vet ./...) ; then
            echo "FAIL: go vet failed. Fix issues before committing."
            exit 1
        fi

        echo "  -> go test..."
        # Scope tests to the packages containing staged Go files (reverse deps
        # are NOT expanded — CI runs the full suite). The full 'go test ./...'
        # run takes 5-8 min in ARM64 Codespaces and routinely stalls parallel
        # commits (bug-85675e04). Set WIPNOTE_HOOK_FULL_TESTS=1 to force the
        # legacy full run.
        # Unset GIT_DIR/GIT_INDEX_FILE so tests that create real git repos
        # (e.g. TestBranchForFilePath) are not polluted by the pre-commit env.
        if [ -n "${WIPNOTE_HOOK_FULL_TESTS:-}" ]; then
            TEST_TARGETS="./..."
        else
            STAGED_PKGS=$(git diff --cached --name-only --diff-filter=ACMR -- '*.go' \
                | xargs -I{} dirname "$REPO_ROOT/{}" 2>/dev/null \
                | sort -u \
                | sed "s|^$REPO_ROOT|.|" \
                | sed 's|^\.$|./|' \
                | sed 's|$|/...|')
            if [ -z "$STAGED_PKGS" ]; then
                echo "     (no staged .go files — skipping test run)"
                STAGED_PKGS=""
            fi
            TEST_TARGETS="$STAGED_PKGS"
        fi
        if [ -n "$TEST_TARGETS" ]; then
            if ! (cd "$REPO_ROOT" && env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE go test $TEST_TARGETS) ; then
                echo "FAIL: go test failed. Fix failing tests before committing."
                echo "      (scoped to staged packages; run 'go test ./...' locally or set WIPNOTE_HOOK_FULL_TESTS=1 for the full suite.)"
                exit 1
            fi
        fi
    fi
fi

# Plugin port drift gate (scoped).
#
# `wipnote plugin check-ports` regenerates every target plugin tree into a
# tempdir and diffs it against the committed trees — that costs 5-30s. Only pay
# it when the staged changeset can actually affect generated output: the
# generator (internal/pluginbuild/), the shared manifest
# (packages/plugin-core/), or the shared/source assets under plugin/. Skip
# entirely for any other changeset.
if git diff --cached --name-only \
    | grep -qE '^(internal/pluginbuild/|packages/plugin-core/|plugin/)' ; then
    echo "  -> plugin check-ports (generator/manifest/plugin path staged)..."
    WIPNOTE_BIN="$(command -v wipnote 2>/dev/null || true)"
    if [ -z "$WIPNOTE_BIN" ]; then
        echo "FAIL: 'wipnote' not found on PATH; cannot run plugin check-ports."
        echo "      Build it with 'wipnote build' (or plugin/build.sh) and retry."
        exit 1
    fi
    if ! (cd "$REPO_ROOT" && "$WIPNOTE_BIN" plugin check-ports) ; then
        echo "FAIL: generated plugin trees are out of sync with plugin-core."
        echo "      Run 'wipnote plugin build-ports' and stage the regenerated trees."
        exit 1
    fi
fi

# Reject stray wipnote binary at repo root (use `wipnote build` instead)
if git diff --cached --name-only | grep -q '^wipnote$'; then
    echo "FAIL: A binary named 'wipnote' is staged at the repo root."
    echo "      Run 'wipnote build' instead — it outputs to ~/.local/bin/wipnote."
    echo "      Unstage it with: git reset HEAD wipnote"
    exit 1
fi

# Scan staged .wipnote/ and .claude/ artifacts for host-local absolute paths
if git diff --cached --name-only | grep -qE '^(\.wipnote/|\.claude/)'; then
    echo "  -> check-host-paths (staged)..."
    if ! "$REPO_ROOT/scripts/check-host-paths.sh" --staged ; then
        echo "FAIL: host-local paths found in staged files. See output above."
        exit 1
    fi
fi

echo "All pre-commit checks passed!"
